APP_NAME=AeroComply
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://aerocomply:aerocomply@localhost:5432/aerocomply

JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aerocomply_dev

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aerocomply
S3_SECRET_KEY=aerocomply_dev_secret
S3_BUCKET=aerocomply-evidence

# AI agent (Lisa) — optional local or remote provider
# AI_PROVIDER=auto  # auto | openai_compatible | anthropic | none
# AI_BASE_URL=http://localhost:11434/v1  # e.g. Ollama or http://localhost:8000/v1 for vLLM
# AI_MODEL=qwen2.5:14b  # e.g. qwen2.5:14b, llama3.3:70b
